# LLM Provider: "anthropic" or "openai"
LLM_PROVIDER=anthropic

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI (fallback provider + embeddings)
OPENAI_API_KEY=sk-...

# PostgreSQL (matches docker-compose.yml)
DATABASE_URL=postgresql://alpha:alpha@db:5432/alphaagent

# Paper trading poll interval (seconds)
PAPER_TRADE_INTERVAL=30
