{
  "metadata": {
    "title": "Do Factor Strategies Beat the Market? Sometimes Yes. Sometimes No.",
    "authors": [
      "Edward F. McQuarrie"
    ],
    "year": 2025,
    "venue": "SSRN working paper",
    "identifier": "SSRN 5098799",
    "pages": 18
  },
  "summary": "Argues that statistically robust long-short factor premia (size, value) are compatible with long-only, with-cost factor portfolios lagging the market for a decade or more. Uses DFA fund histories (Exhibits 1-2), an SBBI/fund-based sub-period breakdown of small vs large stocks 1926-2023 with skewness probes (Exhibit 3) and trailing 10-year returns of big growth stocks vs the market from the French library (Exhibit 4).",
  "thesis": "Factor premia are real on average but fluctuate: when you invest determines whether a long-only factor tilt beats the market.",
  "key_takeaways": [
    "Recent academic work validates many factors with global data; arbitrage-away concerns are put to rest.",
    "Academic factors are long-short and cost-free; investors hold long-only portfolios with costs, which show recurrent decade-long underperformance.",
    "A positive long-run monthly mean is compatible with arbitrarily long periods of long-only underperformance."
  ],
  "claims": [
    {
      "id": "C1",
      "statement": "A positive long-run monthly average premium on a long-short factor (SMB, HML) is compatible with long-only factor portfolios underperforming the market for a decade or more.",
      "kind": "main_thesis",
      "evidence": "Exhibits 1-4",
      "page": 2,
      "testable": true,
      "how_to_test": "Compute rolling 10-20y long-only factor-portfolio minus market annualized returns from French data; count windows < 0 while full-sample SMB/HML mean > 0."
    },
    {
      "id": "C2",
      "statement": "All of the 1926-2023 small-stock excess return occurred in 1964-1981; 1926-1963 and 1982-2023 net to roughly zero (+7bp, -17bp).",
      "kind": "empirical",
      "evidence": "Exhibit 3",
      "page": 10,
      "testable": true,
      "how_to_test": "Annualized returns of small-cap portfolio vs large-cap index per sub-period."
    },
    {
      "id": "C3",
      "statement": "Removing the 4 most extreme years (1933, 1943, 1945, 1967) eliminates the small-stock advantage (-8bp); removing WWII years cuts it from 161bp to 41bp.",
      "kind": "empirical",
      "evidence": "Exhibit 3 skewness probes",
      "page": 11,
      "testable": true,
      "how_to_test": "Rank years by small minus large return, drop top 4, re-annualize the remaining 94 years."
    },
    {
      "id": "C4",
      "statement": "DFA Microcap fund trailed the S&P 500 fund by ~2x in wealth 1982-1999 and doubled it 1999-2017; ending ~equal over 42 years.",
      "kind": "empirical",
      "evidence": "Exhibit 1",
      "page": 5,
      "testable": true,
      "how_to_test": "Total-return series of DFSCX vs VFINX from Yahoo Finance."
    },
    {
      "id": "C5",
      "statement": "DFA Large Value beat Vanguard Total Market by 30% in wealth 1993-2007 and trailed by 30% 2007-2021.",
      "kind": "empirical",
      "evidence": "Exhibit 2",
      "page": 6,
      "testable": true,
      "how_to_test": "DFLVX vs VTSMX total returns."
    },
    {
      "id": "C6",
      "statement": "Big low-B/M (growth) stocks - the anti-factor - outperformed the market over many trailing 10-year windows (1930s, 1990s, 2010s-2020s) and underperformed by up to ~4.5%/yr in windows ending in the early 1980s.",
      "kind": "empirical",
      "evidence": "Exhibit 4",
      "page": 12,
      "testable": true,
      "how_to_test": "French 6 portfolios ME/BM, BIG LoBM VW minus Mkt, trailing 120m annualized."
    },
    {
      "id": "C7",
      "statement": "Large value outperformed the market in every 120-month roll ending within 1963-1990.",
      "kind": "empirical",
      "evidence": "Text p.13 (no exhibit)",
      "page": 13,
      "testable": true,
      "how_to_test": "French BIG HiBM minus Mkt, trailing 120m, roll ends 1963-1990: all > 0."
    },
    {
      "id": "C8",
      "statement": "Periods of factor underperformance are best explained by random fluctuation of two volatile, imperfectly correlated series rather than arbitrage, macro variables or sector composition.",
      "kind": "interpretive",
      "evidence": "Argument, no formal test",
      "page": 12,
      "testable": true,
      "how_to_test": "Monte Carlo / block bootstrap of factor & market returns with the historical mean, vol and correlation; compare frequency/length of decade-long underperformance spells with history."
    },
    {
      "id": "C9",
      "statement": "SMB (arithmetic, long-short) does not track the difference in annualized long-only returns; SMB is positive in most sub-periods regardless of sign of the long-only spread.",
      "kind": "methodological",
      "evidence": "Exhibit 3 SMB column",
      "page": 11,
      "testable": true,
      "how_to_test": "Compare per-period SMB mean with geometric small-minus-market spread."
    },
    {
      "id": "C10",
      "statement": "Researchers should report when factors outperformed, dependence on shorting the anti-factor and on ignoring costs, and the skewness/volatility of outperformance.",
      "kind": "recommendation",
      "evidence": "Conclusion",
      "page": 14,
      "testable": false,
      "how_to_test": ""
    }
  ],
