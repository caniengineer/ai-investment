  "methodology": {
    "research_question": "Do long-only, with-cost factor portfolios beat the market over investor-relevant horizons, given robust long-short statistical evidence?",
    "asset_universe": "US equities",
    "sample_period": "1926-2023",
    "sample_years": 98.0,
    "frequency": "annual (Exhibit 3), monthly (Exhibits 2, 4)",
    "portfolio_construction": "Small: SBBI small stocks to 1981 then DFA Microcap fund; value: DFA Large Value fund; anti-factor: French 2x3 BIG/LoBM (above-median ME, bottom 30% B/M)",
    "weighting": "value-weighted (French portfolios); fund weighting",
    "rebalancing": "annual (French, end of June); fund-managed",
    "benchmark": "S&P 90/500 (SBBI) then Vanguard 500 fund; Vanguard Total Stock Market fund; French market return",
    "long_short": false,
    "transaction_costs_modeled": null,
    "fees_included": true,
    "statistical_tests": [],
    "significance_reported": false,
    "out_of_sample_test": false,
    "robustness_checks": [
      "sub-period breakdowns (3 and 6 periods)",
      "drop 4 most extreme years",
      "drop WWII years",
      "wealth path reset at turning points"
    ],
    "n_strategies_tested": 3,
    "multiple_testing_adjustment": null,
    "survivorship_bias_addressed": null,
    "lookahead_bias_addressed": null,
    "key_formulas": [
      "annualized return = (prod(1+r_t))^(1/years) - 1",
      "Exhibit 4: trailing 120m annualized(BIG LoBM) - annualized(Mkt)",
      "SMB = average monthly long-short spread (arithmetic)"
    ],
    "notes": "Mixes index data (SBBI, gross of costs) with fund data (net of fees) in one series; start/end dates and 'reset' points are chosen ex post at turning points."
  },
